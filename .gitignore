# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# superpowers brainstorming
/.superpowers/

# Member photos — kept out of git for privacy (EXIF metadata) and
# blob bloat. Files live on the server filesystem and are served
# directly; swap them there without touching the repo.
/public/members/

# Admin-uploaded images (runtime assets, not git-tracked).
# Stored outside public/ because Next 16 + Turbopack only serves
# public/ files known at build time; served via dynamic route handler.
/uploaded-assets/

# pedalplayground catalog images (~3GB) bundled on the server.
# Sync separately on each host; do not bloat the repo.
/public/playground/images/

# 네이버 합주실 다운로드 이미지(권한 확인 전 내부 저장 전용) + 생성 데이터/로그.
# 바이너리·미게시 자료라 git 추적 안 함.
/public/images/naver-hapjusil/
/logs/

# typescript
*.tsbuildinfo
next-env.d.ts
